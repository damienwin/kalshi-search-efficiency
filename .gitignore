# Secrets / PII — never commit
.env
private/

# Data: only manifests are committed
data/raw/
data/build/
sealed/*
!sealed/README.md

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.pytest_cache/
catboost_info/

# OS / IDE
.DS_Store
.vscode/
.idea/
.claude/

# Search runs: per-event dev predictions (labels, tickers) stay local
runs/

# rendered reports stay local
docs/reports/*.pdf

# paper build outputs (never commit PDFs)
paper/*.pdf
paper/*.aux
paper/*.log
paper/*.bbl
paper/*.blg
paper/*.out
paper/figures/*.pdf
paper/*.zip
# advisor-facing planning notes stay local
paper/outline.*

# local logs and per-event prediction tables (labels, tickers) stay local
data/logs/
results/*.parquet

# paper draft stays local (shared via Overleaf)
paper/
